{
  "name": "yaml_nunjucks",
  "rules": {
    "document": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "_line"
      }
    },
    "_line": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SEQ",
          "members": [
            {
              "type": "CHOICE",
              "members": [
                {
                  "type": "PATTERN",
                  "value": "[ \\t]+"
                },
                {
                  "type": "BLANK"
                }
              ]
            },
            {
              "type": "CHOICE",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "nunjucks_statement"
                },
                {
                  "type": "SYMBOL",
                  "name": "nunjucks_comment"
                },
                {
                  "type": "SYMBOL",
                  "name": "yaml_pair"
                },
                {
                  "type": "SYMBOL",
                  "name": "yaml_list_item"
                },
                {
                  "type": "SYMBOL",
                  "name": "comment"
                }
              ]
            },
            {
              "type": "PATTERN",
              "value": "\\r?\\n"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "blank_line"
        }
      ]
    },
    "blank_line": {
      "type": "PATTERN",
      "value": "[ \\t]*\\r?\\n"
    },
    "nunjucks_statement": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{%"
        },
        {
          "type": "PATTERN",
          "value": "([^%]|%[^}])*"
        },
        {
          "type": "STRING",
          "value": "%}"
        }
      ]
    },
    "nunjucks_expression": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{{"
        },
        {
          "type": "SYMBOL",
          "name": "_expr_content"
        },
        {
          "type": "STRING",
          "value": "}}"
        }
      ]
    },
    "_expr_content": {
      "type": "PATTERN",
      "value": "([^}]|}[^}])+"
    },
    "nunjucks_comment": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{#"
        },
        {
          "type": "PATTERN",
          "value": "([^#]|#[^}])*#*"
        },
        {
          "type": "STRING",
          "value": "}"
        }
      ]
    },
    "yaml_pair": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "yaml_key"
        },
        {
          "type": "STRING",
          "value": ":"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "PATTERN",
                  "value": "[ \\t]+"
                },
                {
                  "type": "SYMBOL",
                  "name": "yaml_value"
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "yaml_key": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "yaml_string"
        },
        {
          "type": "PATTERN",
          "value": "[^\\s:\\[\\]{},\"'#]+"
        }
      ]
    },
    "yaml_value": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "yaml_string"
        },
        {
          "type": "SYMBOL",
          "name": "yaml_mixed"
        },
        {
          "type": "SYMBOL",
          "name": "nunjucks_expression"
        },
        {
          "type": "PATTERN",
          "value": "[^\\s\\[\\]{},\"'#]+"
        }
      ]
    },
    "yaml_mixed": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SEQ",
          "members": [
            {
              "type": "SYMBOL",
              "name": "nunjucks_expression"
            },
            {
              "type": "REPEAT1",
              "content": {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "SYMBOL",
                    "name": "nunjucks_expression"
                  },
                  {
                    "type": "PATTERN",
                    "value": "[^\\s\\[\\]{},\"'#\\n]+"
                  }
                ]
              }
            }
          ]
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "PATTERN",
              "value": "[^\\s\\[\\]{},\"'#\\n]+"
            },
            {
              "type": "REPEAT1",
              "content": {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "SYMBOL",
                    "name": "nunjucks_expression"
                  },
                  {
                    "type": "PATTERN",
                    "value": "[^\\s\\[\\]{},\"'#\\n]+"
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    "yaml_list_item": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "-"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "PATTERN",
                  "value": "[ \\t]+"
                },
                {
                  "type": "SYMBOL",
                  "name": "yaml_value"
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "yaml_string": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "\""
            },
            {
              "type": "REPEAT",
              "content": {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "SYMBOL",
                    "name": "nunjucks_expression"
                  },
                  {
                    "type": "PATTERN",
                    "value": "[^\"\\n\\\\]+"
                  },
                  {
                    "type": "PATTERN",
                    "value": "\\\\."
                  }
                ]
              }
            },
            {
              "type": "STRING",
              "value": "\""
            }
          ]
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "'"
            },
            {
              "type": "REPEAT",
              "content": {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "SYMBOL",
                    "name": "nunjucks_expression"
                  },
                  {
                    "type": "PATTERN",
                    "value": "[^'\\n\\\\]+"
                  },
                  {
                    "type": "PATTERN",
                    "value": "\\\\."
                  }
                ]
              }
            },
            {
              "type": "STRING",
              "value": "'"
            }
          ]
        }
      ]
    },
    "comment": {
      "type": "PATTERN",
      "value": "#[^\\n]*"
    }
  },
  "extras": [],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": []
}

