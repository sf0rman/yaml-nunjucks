{
  "name": "yaml_nunjucks",
  "rules": {
    "document": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "_line"
      }
    },
    "_line": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SEQ",
          "members": [
            {
              "type": "CHOICE",
              "members": [
                {
                  "type": "PATTERN",
                  "value": "[ \\t]+"
                },
                {
                  "type": "BLANK"
                }
              ]
            },
            {
              "type": "CHOICE",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "nunjucks_statement"
                },
                {
                  "type": "SYMBOL",
                  "name": "nunjucks_comment"
                },
                {
                  "type": "SYMBOL",
                  "name": "yaml_pair"
                },
                {
                  "type": "SYMBOL",
                  "name": "yaml_list_item"
                },
                {
                  "type": "SYMBOL",
                  "name": "comment"
                }
              ]
            },
            {
              "type": "PATTERN",
              "value": "\\r?\\n"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "blank_line"
        }
      ]
    },
    "blank_line": {
      "type": "PATTERN",
      "value": "[ \\t]*\\r?\\n"
    },
    "nunjucks_statement": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{%"
        },
        {
          "type": "PATTERN",
          "value": "[ \\t]*"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "nunjucks_keyword"
                },
                {
                  "type": "PATTERN",
                  "value": "[ \\t]+"
                },
                {
                  "type": "SYMBOL",
                  "name": "_statement_rest"
                }
              ]
            },
            {
              "type": "SYMBOL",
              "name": "nunjucks_keyword"
            },
            {
              "type": "SYMBOL",
              "name": "_statement_rest"
            }
          ]
        },
        {
          "type": "PATTERN",
          "value": "[ \\t]*"
        },
        {
          "type": "STRING",
          "value": "%}"
        }
      ]
    },
    "nunjucks_keyword": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "STRING",
            "value": "if"
          },
          {
            "type": "STRING",
            "value": "elif"
          },
          {
            "type": "STRING",
            "value": "else"
          },
          {
            "type": "STRING",
            "value": "endif"
          },
          {
            "type": "STRING",
            "value": "for"
          },
          {
            "type": "STRING",
            "value": "in"
          },
          {
            "type": "STRING",
            "value": "endfor"
          },
          {
            "type": "STRING",
            "value": "set"
          },
          {
            "type": "STRING",
            "value": "block"
          },
          {
            "type": "STRING",
            "value": "endblock"
          },
          {
            "type": "STRING",
            "value": "macro"
          },
          {
            "type": "STRING",
            "value": "endmacro"
          },
          {
            "type": "STRING",
            "value": "call"
          },
          {
            "type": "STRING",
            "value": "endcall"
          },
          {
            "type": "STRING",
            "value": "filter"
          },
          {
            "type": "STRING",
            "value": "endfilter"
          },
          {
            "type": "STRING",
            "value": "extends"
          },
          {
            "type": "STRING",
            "value": "include"
          },
          {
            "type": "STRING",
            "value": "import"
          },
          {
            "type": "STRING",
            "value": "from"
          }
        ]
      }
    },
    "_statement_rest": {
      "type": "PATTERN",
      "value": "([^%]|%[^}])*"
    },
    "nunjucks_expression": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{{"
        },
        {
          "type": "SYMBOL",
          "name": "_expr_content"
        },
        {
          "type": "STRING",
          "value": "}}"
        }
      ]
    },
    "_expr_content": {
      "type": "PATTERN",
      "value": "([^}]|}[^}])+"
    },
    "nunjucks_comment": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{#"
        },
        {
          "type": "PATTERN",
          "value": "([^#]|#[^}])*#*"
        },
        {
          "type": "STRING",
          "value": "}"
        }
      ]
    },
    "yaml_pair": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "yaml_key"
        },
        {
          "type": "STRING",
          "value": ":"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "PATTERN",
                  "value": "[ \\t]+"
                },
                {
                  "type": "SYMBOL",
                  "name": "yaml_value"
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "yaml_key": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "yaml_string"
        },
        {
          "type": "SYMBOL",
          "name": "cf_tag"
        },
        {
          "type": "PATTERN",
          "value": "[^\\s:\\[\\]{},\"'#!]+"
        }
      ]
    },
    "yaml_value": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "yaml_string"
        },
        {
          "type": "SYMBOL",
          "name": "yaml_mixed"
        },
        {
          "type": "SYMBOL",
          "name": "nunjucks_expression"
        },
        {
          "type": "SYMBOL",
          "name": "cf_intrinsic"
        },
        {
          "type": "PATTERN",
          "value": "[^\\s\\[\\]{},\"'#!]+"
        }
      ]
    },
    "cf_tag": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "STRING",
            "value": "!Ref"
          },
          {
            "type": "STRING",
            "value": "!Sub"
          },
          {
            "type": "STRING",
            "value": "!GetAtt"
          },
          {
            "type": "STRING",
            "value": "!Join"
          },
          {
            "type": "STRING",
            "value": "!Select"
          },
          {
            "type": "STRING",
            "value": "!Split"
          },
          {
            "type": "STRING",
            "value": "!FindInMap"
          },
          {
            "type": "STRING",
            "value": "!Base64"
          },
          {
            "type": "STRING",
            "value": "!GetAZs"
          },
          {
            "type": "STRING",
            "value": "!ImportValue"
          },
          {
            "type": "STRING",
            "value": "!If"
          },
          {
            "type": "STRING",
            "value": "!Equals"
          },
          {
            "type": "STRING",
            "value": "!Not"
          },
          {
            "type": "STRING",
            "value": "!And"
          },
          {
            "type": "STRING",
            "value": "!Or"
          },
          {
            "type": "STRING",
            "value": "!GetOrganizationBinding"
          },
          {
            "type": "STRING",
            "value": "!Include"
          },
          {
            "type": "STRING",
            "value": "!Foreach"
          }
        ]
      }
    },
    "cf_intrinsic": {
      "type": "PREC",
      "value": 2,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "cf_tag"
          },
          {
            "type": "PATTERN",
            "value": "[ \\t]+"
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "yaml_string"
              },
              {
                "type": "SYMBOL",
                "name": "nunjucks_expression"
              },
              {
                "type": "PATTERN",
                "value": "[^\\s\\[\\]{},\"'#\\n]+"
              }
            ]
          }
        ]
      }
    },
    "yaml_mixed": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SEQ",
          "members": [
            {
              "type": "SYMBOL",
              "name": "nunjucks_expression"
            },
            {
              "type": "REPEAT1",
              "content": {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "SYMBOL",
                    "name": "nunjucks_expression"
                  },
                  {
                    "type": "PATTERN",
                    "value": "[^\\s\\[\\]{},\"'#\\n]+"
                  }
                ]
              }
            }
          ]
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "PATTERN",
              "value": "[^\\s\\[\\]{},\"'#\\n]+"
            },
            {
              "type": "REPEAT1",
              "content": {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "SYMBOL",
                    "name": "nunjucks_expression"
                  },
                  {
                    "type": "PATTERN",
                    "value": "[^\\s\\[\\]{},\"'#\\n]+"
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    "yaml_list_item": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "-"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "PATTERN",
                  "value": "[ \\t]+"
                },
                {
                  "type": "CHOICE",
                  "members": [
                    {
                      "type": "SYMBOL",
                      "name": "yaml_pair"
                    },
                    {
                      "type": "SYMBOL",
                      "name": "yaml_value"
                    }
                  ]
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "yaml_string": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "\""
            },
            {
              "type": "REPEAT",
              "content": {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "SYMBOL",
                    "name": "nunjucks_expression"
                  },
                  {
                    "type": "PATTERN",
                    "value": "[^\"\\n\\\\]+"
                  },
                  {
                    "type": "PATTERN",
                    "value": "\\\\."
                  }
                ]
              }
            },
            {
              "type": "STRING",
              "value": "\""
            }
          ]
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "'"
            },
            {
              "type": "REPEAT",
              "content": {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "SYMBOL",
                    "name": "nunjucks_expression"
                  },
                  {
                    "type": "PATTERN",
                    "value": "[^'\\n\\\\]+"
                  },
                  {
                    "type": "PATTERN",
                    "value": "\\\\."
                  }
                ]
              }
            },
            {
              "type": "STRING",
              "value": "'"
            }
          ]
        }
      ]
    },
    "comment": {
      "type": "PATTERN",
      "value": "#[^\\n]*"
    }
  },
  "extras": [],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": []
}

