                    "value": "[^\"\\\\\\n{]+"
                  },
                  {
                    "type": "PATTERN",
                    "value": "\\{"
                  },
                  {
                    "type": "PATTERN",
                    "value": "\\\\."
                  }
                ]
              }
            },
            {
              "type": "STRING",
              "value": "\""
            }
          ]
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "'"
            },
            {
              "type": "REPEAT",
              "content": {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "SYMBOL",
                    "name": "nunjucks_expression"
                  },
                  {
                    "type": "PATTERN",
                    "value": "[^'\\\\\\n{]+"
                  },
                  {
                    "type": "PATTERN",
                    "value": "\\{"
                  },
                  {
                    "type": "PATTERN",
                    "value": "\\\\."
                  }
