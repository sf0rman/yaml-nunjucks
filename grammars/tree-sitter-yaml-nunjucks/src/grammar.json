        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "_flow_item"
                },
                {
                  "type": "REPEAT",
                  "content": {
                    "type": "SEQ",
                    "members": [
                      {
                        "type": "PATTERN",
                        "value": "[ \\t]*,[ \\t]*"
                      },
                      {
                        "type": "SYMBOL",
                        "name": "_flow_item"
                      }
                    ]
                  }
                },
                {
                  "type": "CHOICE",
                  "members": [
                    {
                      "type": "PATTERN",
                      "value": "[ \\t]*"
                    },
                    {
                      "type": "BLANK"
                    }
                  ]
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": "]"
        }
      ]
    },
    "yaml_flow_scalar": {
      "type": "PATTERN",
      "value": "[^ \\t\\n,\\[\\]{}'\"!][^ \\t\\n,\\[\\]{}'\"]*"
    },
    "_flow_item": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "yaml_quoted_string"
