          "value": "set"
        },
        {
          "type": "STRING",
          "value": "block"
        },
        {
          "type": "STRING",
          "value": "endblock"
        },
        {
          "type": "STRING",
          "value": "macro"
        },
        {
          "type": "STRING",
          "value": "endmacro"
        },
        {
          "type": "STRING",
          "value": "call"
        },
        {
          "type": "STRING",
          "value": "endcall"
        },
        {
          "type": "STRING",
          "value": "filter"
        },
        {
          "type": "STRING",
          "value": "endfilter"
        },
        {
          "type": "STRING",
          "value": "raw"
        },
        {
          "type": "STRING",
          "value": "endraw"
        },
        {
          "type": "STRING",
          "value": "extends"
        },
        {
          "type": "STRING",
          "value": "include"
        },
        {
          "type": "STRING",
          "value": "import"
        },
        {
          "type": "STRING",
          "value": "from"
        },
        {
          "type": "STRING",
          "value": "with"
        },
        {
          "type": "STRING",
          "value": "without"
        },
        {
          "type": "STRING",
          "value": "context"
        },
        {
          "type": "STRING",
          "value": "not"
        },
        {
          "type": "STRING",
          "value": "and"
        },
        {
          "type": "STRING",
          "value": "or"
        },
        {
          "type": "STRING",
          "value": "is"
        }
      ]
    },
    "_statement_rest": {
      "type": "REPEAT1",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "PATTERN",
            "value": "[ \\t]+"
          },
          {
            "type": "SYMBOL",
            "name": "_statement_word"
          }
        ]
      }
    },
    "_statement_word": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[a-zA-Z0-9_.|+\\-*\\/=!<>()'\",]+"
      }
    },
    "nunjucks_expression": {
      "type": "SEQ",
      "members": [
        {
          "type": "TOKEN",
          "content": {
            "type": "PREC",
            "value": 2,
            "content": {
              "type": "STRING",
              "value": "{{"
            }
          }
        },
        {
          "type": "SYMBOL",
          "name": "_expr_content"
        },
        {
          "type": "TOKEN",
          "content": {
            "type": "PREC",
            "value": 2,
            "content": {
              "type": "STRING",
              "value": "}}"
            }
          }
        }
      ]
    },
    "_expr_content": {
      "type": "PATTERN",
      "value": "([^}]|}[^}])+"
    },
    "nunjucks_comment": {
      "type": "SEQ",
      "members": [
        {
          "type": "TOKEN",
          "content": {
            "type": "PREC",
            "value": 2,
            "content": {
              "type": "STRING",
              "value": "{#"
            }
          }
        },
        {
          "type": "PATTERN",
          "value": "([^#]|#[^}])*#*"
        },
        {
          "type": "STRING",
          "value": "}"
        }
      ]
    },
    "yaml_pair": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "yaml_key"
        },
        {
          "type": "STRING",
          "value": ":"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "PATTERN",
                  "value": "[ \\t]+"
                },
                {
                  "type": "SYMBOL",
                  "name": "yaml_value"
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "yaml_key": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "yaml_quoted_string"
        },
        {
          "type": "SYMBOL",
          "name": "cf_tag"
        },
        {
          "type": "SYMBOL",
          "name": "yaml_plain_key"
        }
      ]
    },
    "yaml_plain_key": {
      "type": "PATTERN",
      "value": "[^ \\t\\n:\\[\\]{},\"'#!][^ \\t\\n:\\[\\]{},\"'#!]*"
    },
    "yaml_value": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "yaml_quoted_string"
        },
        {
          "type": "SYMBOL",
          "name": "yaml_block_scalar"
        },
        {
          "type": "SYMBOL",
          "name": "yaml_flow_sequence"
        },
        {
          "type": "SYMBOL",
          "name": "yaml_flow_mapping"
        },
        {
          "type": "SYMBOL",
          "name": "cf_intrinsic"
        },
        {
          "type": "SYMBOL",
          "name": "yaml_plain_scalar"
        }
      ]
    },
    "yaml_block_scalar": {
      "type": "PATTERN",
      "value": "[|>][-+]?[0-9]*"
    },
    "yaml_plain_scalar": {
      "type": "PREC_RIGHT",
      "value": 0,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "TOKEN",
            "content": {
              "type": "PREC",
              "value": -1,
              "content": {
                "type": "PATTERN",
                "value": "[^ \\t\\n\\[\\]{},\"'#!|>][^ \\t\\n\\[\\]{},\"']*"
              }
            }
          },
          {
            "type": "REPEAT",
            "content": {
              "type": "CHOICE",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "nunjucks_expression"
                },
                {
                  "type": "TOKEN",
                  "content": {
                    "type": "PATTERN",
                    "value": "[^ \\t\\n\\[\\]{},\"']+"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "yaml_flow_sequence": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "["
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "PATTERN",
              "value": "[ \\t]*"
            },
            {
              "type": "BLANK"
